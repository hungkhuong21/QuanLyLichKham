@startuml Kiến trúc tổng thể - Hệ thống Quản lý lịch khám

!define ACTOR_COLOR #E3F2FD
!define FRONTEND_COLOR #E8F5E9
!define BACKEND_COLOR #FFF3E0
!define DATABASE_COLOR #F3E5F5

title Kiến trúc tổng thể - Hệ thống Quản lý lịch khám

actor "Bệnh nhân" as Patient ACTOR_COLOR
actor "Bác sĩ" as Doctor ACTOR_COLOR
actor "Admin" as Admin ACTOR_COLOR

package "Frontend (Angular)" FRONTEND_COLOR {
    [Web UI] as WebUI
}

package "Backend (Node.js/Express)" BACKEND_COLOR {
    [Auth & User Service] as AuthService
    [Patient Service] as PatientService
    [Doctor Service] as DoctorService
    [Appointment Service] as ApptService
    [Department Service] as DeptService
    [Schedule Work Service] as ScheduleService
    [Reception Service] as ReceptionService
    [Statistics Service] as StatsService
}

database "Database (MySQL)" as Database DATABASE_COLOR {
    [taikhoan] as TaiKhoanTable
    [benhnhan] as BenhNhanTable
    [bacsi] as BacSiTable
    [lichhen] as LichHenTable
    [khoa] as KhoaTable
    [lichlamviec] as LichLamViecTable
    [tiepnhan] as TiepNhanTable
    [trangthaitiepnhan] as TrangThaiTiepNhanTable
}

' Actors to Web UI
Patient --> WebUI
Doctor --> WebUI
Admin --> WebUI

' Web UI to Backend Services
WebUI --> AuthService : REST API\n(Login/Register)
WebUI --> PatientService : REST API\n(Patients)
WebUI --> DoctorService : REST API\n(Doctors)
WebUI --> ApptService : REST API\n(Appointments)
WebUI --> DeptService : REST API\n(Departments)
WebUI --> ScheduleService : REST API\n(Schedules)
WebUI --> ReceptionService : REST API\n(Reception)
WebUI --> StatsService : REST API\n(Statistics)

' Backend Services to Database
AuthService --> TaiKhoanTable
PatientService --> BenhNhanTable
DoctorService --> BacSiTable
ApptService --> LichHenTable
ApptService --> BenhNhanTable
ApptService --> BacSiTable
DeptService --> KhoaTable
ScheduleService --> LichLamViecTable
ScheduleService --> BacSiTable
ReceptionService --> TiepNhanTable
ReceptionService --> LichHenTable
ReceptionService --> TrangThaiTiepNhanTable
StatsService --> LichHenTable
StatsService --> BenhNhanTable
StatsService --> BacSiTable
StatsService --> KhoaTable

note right of WebUI
  Angular Application
  Single Page Application
  Responsive Design
end note

note right of AuthService
  Xác thực người dùng
  Quản lý tài khoản
  Phân quyền truy cập
end note

note right of ApptService
  Quản lý lịch hẹn
  Kiểm tra trùng lịch
  Cập nhật trạng thái
end note

note right of Database
  MySQL Database
  quanlylichkham
  Port: 3306
end note

@enduml

